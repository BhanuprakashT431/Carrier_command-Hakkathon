# =============================================
# Secure AI Career Command Center — Environment
# Copy to .env and fill in real values
# NEVER commit .env to version control
# =============================================

# --- PostgreSQL ---
POSTGRES_DB=career_db
POSTGRES_USER=career_user
POSTGRES_PASSWORD=career_secret_change_in_prod

# --- Backend ---
DATABASE_URL=postgresql://career_user:career_secret_change_in_prod@localhost:5432/career_db
DATABASE_URL_TEST=postgresql://career_user:career_secret_change_in_prod@localhost:5432/career_db_test

NODE_ENV=development
PORT=5000

# JWT — generate strong random secrets (openssl rand -hex 64)
JWT_ACCESS_SECRET=change_this_to_a_64_char_random_secret_for_access_tokens
JWT_REFRESH_SECRET=change_this_to_a_different_64_char_random_secret_for_refresh_tokens
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cookie
COOKIE_SECRET=change_this_to_a_64_char_random_cookie_secret

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Agent Service
AGENTS_SERVICE_URL=http://localhost:8000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_GENERAL=100
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_MAX_ANALYSIS=5

# --- AI Providers ---
# Leave empty to use Demo Mode (no API key required)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Demo mode — set to true to use synthetic data provider
DEMO_MODE=true

# --- Agent Service (Python) ---
AGENTS_PORT=8000
AGENTS_DATABASE_URL=postgresql://career_user:career_secret_change_in_prod@localhost:5432/career_db

# --- Frontend ---
VITE_API_URL=http://localhost:5000/api
VITE_AGENTS_URL=http://localhost:8000
VITE_DEMO_MODE=true
